rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin rule
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ballakparank08@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidNote(data) {
      return data.title is string &&
             data.title.size() <= 500 &&
             data.paragraphs is list &&
             data.paragraphs.size() <= 1000;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // NoteFlow: Users collection and all user subcollections (notes, settings, attachments)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email
      ));
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter
    match /newsletter/{subId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // System config
    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
